# Estas credenciales pertenecen al servidor, nunca a la APK.
TISKZ_API_URL=https://web-repo-xi.vercel.app/api/v1
TISKZ_MCP_URL=https://web-repo-xi.vercel.app/api/v1/mcp
TISKZ_AUDIO_API_URL=https://web-repo-xi.vercel.app/api/v1/audio-fragments
TISKZ_ORG_ID=org_uav
TISKZ_API_KEY=
TISKZ_EVIDENCE_SIMULATED=true

# Respaldo de control telefónico; secreto exclusivo del backend.
VAPI_API_KEY=
VAPI_SCRIBE_SHADOW_ENABLED=false
VAPI_PHONE_EVIDENCE_ENABLED=false
# Requiere el motor instalado y el consentimiento de voz enviado por la APK.
VOICEPRINT_ENABLED=false
VOICEPRINT_DIR=/data/voiceprint

# Candidato GPT-Live: secreto propio del MCP, solo servidor; apagado por defecto.
VAPI_LIVE_MCP_ENABLED=false
VAPI_LIVE_MCP_SECRET=

# Reportes usando el saldo de IA de Maritime. Activar "Use Maritime LLM" en el agente.
# Maritime inyecta OPENAI_API_KEY y OPENAI_BASE_URL como secretos del servidor.
TISKZ_REPORT_PROVIDER=maritime
TISKZ_REPORT_MODEL=gpt-4.1-mini
TISKZ_REPORTS_ENABLED=true
TISKZ_REPORTS_SIMULATED=true
# TISKZ_API_KEY y TISKZ_ORG_ID se comparten con la integración existente.
